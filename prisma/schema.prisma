generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  role          String   @default("employer") // employer, worker, admin
  avatar        String?
  isVerified    Boolean  @default(false)
  workerId      String?  @unique
  employerId    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  worker        Worker?  @relation(fields: [workerId], references: [id])
  employer      Employer? @relation(fields: [employerId], references: [id])
}

model Worker {
  id                 String   @id @default(cuid())
  name               String
  phone              String
  email              String?
  age                Int?
  gender             String   @default("female")
  profileImage       String?
  role               String
  roles              String   @default("[]")
  city               String
  locality           String?
  pincode            String?
  experienceYears    Int      @default(0)
  salaryExpectation  Int?
  availabilityType   String   @default("full-time")
  languages          String   @default("[]")
  skills             String   @default("[]")
  about              String?
  aadhaarVerified    Boolean  @default(false)
  policeVerified     Boolean  @default(false)
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  isPremium          Boolean  @default(false)
  isAvailable        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reviews        Review[]
  bookings       Booking[]
  attendances    Attendance[]
  salaryRecords  SalaryRecord[]
  applications   JobApplication[]
  user           User?
}

model Employer {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  city         String
  locality     String?
  pincode      String?
  plan         String   @default("free")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
  reviews      Review[]
  user         User?
}

model Booking {
  id           String   @id @default(cuid())
  workerId     String
  employerId   String
  status       String   @default("pending")
  startDate    DateTime
  endDate      DateTime?
  salary       Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker       Worker   @relation(fields: [workerId], references: [id])
  employer     Employer @relation(fields: [employerId], references: [id])
}

model Review {
  id           String   @id @default(cuid())
  workerId     String
  employerId   String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  worker       Worker   @relation(fields: [workerId], references: [id])
  employer     Employer @relation(fields: [employerId], references: [id])
}

model Attendance {
  id           String   @id @default(cuid())
  workerId     String
  date         String
  checkIn      String?
  checkOut     String?
  status       String   @default("present")
  notes        String?
  createdAt    DateTime @default(now())

  worker       Worker   @relation(fields: [workerId], references: [id])
}

model SalaryRecord {
  id           String   @id @default(cuid())
  workerId     String
  month        String
  amount       Int
  paidOn       DateTime?
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  worker       Worker   @relation(fields: [workerId], references: [id])
}

model JobApplication {
  id           String   @id @default(cuid())
  workerId     String
  jobTitle     String
  employerName String?
  city         String
  salary       Int?
  status       String   @default("applied")
  appliedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker       Worker   @relation(fields: [workerId], references: [id])
}